#include "RMaker.h"
#include "WiFi.h"
#include "WiFiProv.h"

// Relay GPIO pins
#define RELAY1 23
#define RELAY2 22
#define RELAY3 21
#define RELAY4 19

// Relay states
bool relay1_state = false;
bool relay2_state = false;
bool relay3_state = false;
bool relay4_state = false;

// RainMaker devices
Switch light1("Light 1", &relay1_state);
Switch light2("Light 2", &relay2_state);
Switch fan("Fan", &relay3_state);
Switch socket1("Socket", &relay4_state);

// Callback function
void write_callback(Device *device, Param *param, const param_val_t val, void *priv_data) {

    String device_name = device->getDeviceName();

    if (device_name == "Light 1") {
        relay1_state = val.val.b;
        digitalWrite(RELAY1, relay1_state ? LOW : HIGH);
    }
    else if (device_name == "Light 2") {
        relay2_state = val.val.b;
        digitalWrite(RELAY2, relay2_state ? LOW : HIGH);
    }
    else if (device_name == "Fan") {
        relay3_state = val.val.b;
        digitalWrite(RELAY3, relay3_state ? LOW : HIGH);
    }
    else if (device_name == "Socket") {
        relay4_state = val.val.b;
        digitalWrite(RELAY4, relay4_state ? LOW : HIGH);
    }

    param->updateAndReport(val);
}

void sysProvEvent(arduino_event_t *sys_event) {
    switch (sys_event->event_id) {
        case ARDUINO_EVENT_PROV_START:
            Serial.println("📡 Provisioning Started. Open RainMaker App.");
            break;
        case ARDUINO_EVENT_WIFI_STA_CONNECTED:
            Serial.println("✅ Connected to WiFi");
            break;
        default:
            break;
    }
}

void setup() {
    Serial.begin(115200);

    // Initialize relay pins
    pinMode(RELAY1, OUTPUT);
    pinMode(RELAY2, OUTPUT);
    pinMode(RELAY3, OUTPUT);
    pinMode(RELAY4, OUTPUT);

    // Turn OFF relays (Active LOW)
    digitalWrite(RELAY1, HIGH);
    digitalWrite(RELAY2, HIGH);
    digitalWrite(RELAY3, HIGH);
    digitalWrite(RELAY4, HIGH);

    // Initialize RainMaker Node
    Node my_node = RMaker.initNode("ESP32 Home Automation");

    // Attach callback
    light1.addCb(write_callback);
    light2.addCb(write_callback);
    fan.addCb(write_callback);
    socket1.addCb(write_callback);

    // Add devices
    my_node.addDevice(light1);
    my_node.addDevice(light2);
    my_node.addDevice(fan);
    my_node.addDevice(socket1);

    // Enable OTA updates
    RMaker.enableOTA(OTA_USING_PARAMS);

    // Start RainMaker
    RMaker.start();

    // WiFi Provisioning via BLE
    WiFi.onEvent(sysProvEvent);

    WiFiProv.beginProvision(
        WIFI_PROV_SCHEME_BLE,
        WIFI_PROV_SCHEME_HANDLER_FREE_BTDM,
        WIFI_PROV_SECURITY_1,
        "12345678",           // POP (Proof of Possession)
        "ESP32_RainMaker"     // Device name shown in app
    );
}

void loop() {
    // Nothing required
}
