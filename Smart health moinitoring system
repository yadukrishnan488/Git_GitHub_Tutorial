void setup_extraUltrasonic() {
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  Serial.println("HC-SR04 solenoid control active...");
}


void loop_extraUltrasonic() {
  // Trigger the sensor
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  // Measure echo time
  long duration = pulseIn(ECHO_PIN, HIGH, 25000); // timeout for safety
  float distance = (duration * 0.0343) / 2.0;     // Convert to cm

  // Ignore invalid readings
  if (distance <= 0 || distance > 400) return;

  // --- Calculate percentage (0–100%) ---
  if (distance >= ON_THRESHOLD) {
    distancePercent = 0.0;
  } else if (distance <= OFF_THRESHOLD) {
    distancePercent = 100.0;
  } else {
    distancePercent = ((ON_THRESHOLD - distance) / (ON_THRESHOLD - OFF_THRESHOLD)) * 100.0;
  }

  // --- Hysteresis logic controlling solenoid ---
  if (distance >= ON_THRESHOLD) {
    solenoidAutoState = true;   // Object far → solenoid ON
  } else if (distance <= OFF_THRESHOLD) {
    solenoidAutoState = false;  // Object near → solenoid OFF
  }

  digitalWrite(SOLENOID_PIN, solenoidAutoState ? HIGH : LOW);

  // // --- Serial Output ---
  // Serial.print("Distance: ");
  // Serial.print(distance);
  // Serial.print(" cm | Percentage: ");
  // Serial.print(distancePercent, 1);
  // Serial.print("% | Solenoid: ");
  // Serial.println(solenoidAutoState ? "ON" : "OFF");

    // --- Display distance percentage on LCD (top-right corner) ---
  lcd.setCursor(12, 0);  // Column 13 (right side), Row 0 (top line)
  lcd.print("BOTL");
  lcd.print((int)distancePercent);  // show integer part only
  lcd.print("%");
  // Blynk.virtualWrite(V7, distancePercent); 


}

void updateBlynkData() {
  if (millis() - lastBlynkUpdate >= BLYNK_UPDATE_INTERVAL) {
    lastBlynkUpdate = millis();

    // Send all Blynk virtual writes at once
    Blynk.virtualWrite(V0, 0); // reset pump button in app (momentary)
    Blynk.virtualWrite(V1, heartRatePulse);    // Heart Rate
    Blynk.virtualWrite(V2, spo2);              // SpO2
    Blynk.virtualWrite(V3, temperature);       // Temperature
    Blynk.virtualWrite(V4, statusText);        // Status
    Blynk.virtualWrite(V5, EMERGENCY_STOP);    // optional, could send stop state
    Blynk.virtualWrite(V6, pumpRunning ? "Pumping" : "Idle"); // Pump status
    Blynk.virtualWrite(V7, distancePercent);   // Solenoid percentage
  }
}






