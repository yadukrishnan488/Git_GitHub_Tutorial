// ------------------- BUTTON HANDLING -------------------
void handleButtons() {
  int selectState = digitalRead(BTN_SELECT);
  int downState = digitalRead(BTN_DOWN);
  int upState = digitalRead(BTN_UP);
  unsigned long currentMillis = millis();

  // Basic debounce window
  if (currentMillis - lastDebounce > DEBOUNCE_MS) {

    // Select button pressed (toggle between Heart and SpO2)
    if (selectState == LOW && lastSelectState == HIGH) {
      // Toggle only between 1 and 2 (do not include temp)
      selectedSensor = (selectedSensor == 1) ? 2 : 1;
    }

    // Down button pressed
    if (downState == LOW && lastDownState == HIGH) {
      if (selectedSensor == 1) {
        heartRatePulse -= 2;
        if (heartRatePulse < HEART_MIN) heartRatePulse = HEART_MIN;
      } else if (selectedSensor == 2) {
        spo2 -= 1;
        if (spo2 < SPO2_MIN) spo2 = SPO2_MIN;
      }
    }

    // Up button pressed
    if (upState == LOW && lastUpState == HIGH) {
      if (selectedSensor == 1) {
        heartRatePulse += 2;
        if (heartRatePulse > HEART_MAX) heartRatePulse = HEART_MAX;
      } else if (selectedSensor == 2) {
        spo2 += 1;
        if (spo2 > SPO2_MAX) spo2 = SPO2_MAX;
      }
    }

    if ((selectState != lastSelectState) || (downState != lastDownState) || (upState != lastUpState)) {
      lastDebounce = currentMillis;
    }
  }

  lastSelectState = selectState;
  lastDownState = downState;
  lastUpState = upState;
}

// ------------------- LOGIC ----------------------------
void evaluateCondition() {
  bool abnormal = false;
  bool emergency = false;

  // Heart rate
  if (heartRatePulse < HR_LOW || heartRatePulse > HR_HIGH) abnormal = true;
  if (heartRatePulse < HR_LOW || heartRatePulse > HR_HIGH) emergency = true;

  // SpO2
  if (spo2 < SPO2_LOW) abnormal = true;
  if (spo2 < SPO2_DLOW) emergency = true;

  // Temperature
  if (temperature > TEMP_HIGH || temperature < TEMP_LOW) abnormal = true;
  if (temperature > TEMP_DHIGH) emergency = true;

  // Decide status
  if (emergency) {
    statusText = "Emergency    ";
    digitalWrite(BUZZER_PIN, HIGH);
  } else if (abnormal) {
    statusText = "Abnormal   ";
    digitalWrite(BUZZER_PIN, LOW);
  } else {
    statusText = "Normal     ";
    digitalWrite(BUZZER_PIN, LOW);
  }
}

// ------------------- SAFETY ---------------------------
void safetyCheck() {
  if (digitalRead(EMERGENCY_STOP) == LOW) {
    digitalWrite(PUMP_PIN, LOW);
    digitalWrite(BUZZER_PIN, HIGH);
    lcd.setCursor(0, 3);
    lcd.print("EMERGENCY STOP!   ");
    Serial.println("EMERGENCY STOP TRIGGERED!");
  }
}
